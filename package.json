{
  "name": "anno-rep-frontend",
  "description": "Frontend for the AnnoREP tool to Restructure, Edit, and Publish annotations",
  "author": {
    "name": "QualitativeDataRepository"
  },
  "version": "1.0.0",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/QualitativeDataRepository/AnnoREP-Frontend.git"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.x"
  },
  "overrides": {
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max_old_space_size=2096 next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext ts --ext tsx --ext js",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "jest --watch",
    "test:all-unit": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "gh-pages -d storybook-static",
    "bumpversion-patch": "npm version patch -m 'Bump version: %s'",
    "bumpversion-minor": "npm version minor -m 'Bump version: %s'",
    "bumpversion-major": "npm version major -m 'Bump version: %s'"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run type-check"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint:fix",
      "npm run format"
    ]
  },
  "dependencies": {
    "@carbon/react": "^1.108.0",
    "@prisma/client": "^2.27.0",
    "axios": "^1.15.1",
    "axios-retry": "^4.2.0",
    "form-data": "^4.0.0",
    "formidable": "^3.2.4",
    "isomorphic-dompurify": "^0.15.0",
    "lodash": "^4.17.23",
    "next": "16.2.7",
    "next-auth": "^4.24.13",
    "qs": "^6.14.2",
    "react": "^18.2.0",
    "react-copy-to-clipboard": "^5.0.3",
    "react-dom": "^18.2.0",
    "react-pdf": "^7.7.3",
    "react-sizeme": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@storybook/addon-a11y": "10.4.2",
    "@storybook/addon-docs": "10.4.2",
    "@storybook/nextjs": "10.4.2",
    "@storybook/react": "10.4.2",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^11.2.5",
    "@types/formidable": "^1.2.2",
    "@types/jest": "^26.0.20",
    "@types/lodash": "^4.14.175",
    "@types/node": "^14.14.31",
    "@types/qs": "^6.9.18",
    "@types/react": "18.2.0",
    "@types/react-copy-to-clipboard": "^5.0.0",
    "@types/react-dom": "18.2.0",
    "@types/react-pdf": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "gh-pages": "^5.0.0",
    "glob": "^11.0.0",
    "husky": "^4.3.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "lint-staged": "^10.5.4",
    "minimatch": "^10.0.0",
    "prettier": "^2.4.1",
    "react-docgen-typescript": "^1.21.0",
    "storybook": "10.4.2",
    "typescript": "^6.0.0",
    "eslint-plugin-storybook": "10.4.2"
  }
}
